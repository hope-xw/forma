{
  "name": "design-platform",
  "version": "0.15.0",
  "description": "Forma — Web & 移动 H5 设计与 React/TypeScript 工程交付工作台",
  "author": "Forma Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "mcp": "node --import tsx server/mcp.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "dev:agent": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "format": "prettier --write src server tests electron \"scripts/**/*.{ts,js,mjs}\" *.json *.ts",
    "format:check": "prettier --check src server tests electron \"scripts/**/*.{ts,js,mjs}\" *.json *.ts",
    "lint:arch": "node scripts/check-architecture.mjs",
    "test:browser": "node scripts/run-browser-checks.mjs",
    "test:exports": "node scripts/verify-exports.mjs",
    "release:assess": "tsx scripts/release/pipeline.ts assess",
    "release:check": "tsx scripts/release/pipeline.ts check",
    "release:verify-dmg": "tsx scripts/release/pipeline.ts verify-dmg",
    "release:run": "tsx scripts/release/pipeline.ts run",
    "electron:start": "npm run build && npm run desktop:service && npm run desktop:agent && electron .",
    "desktop:pack": "npm run build && npm run desktop:service && npm run desktop:agent && electron-builder --dir",
    "desktop:build": "npm run build && npm run desktop:service && npm run desktop:agent && electron-builder",
    "dev:libraries": "node --import tsx server/library-service.ts",
    "desktop:service": "esbuild server/library-service.ts --platform=node --bundle --format=esm --outfile=out-electron/library-service.mjs",
    "desktop:agent": "esbuild server/agent-service.ts --platform=node --bundle --format=esm --external:jsdom --external:jsdom/* --external:canvas --external:source-map-support --banner:js=\"import { createRequire as __formaCreateRequire } from 'node:module'; const require = __formaCreateRequire(import.meta.url);\" --outfile=out-electron/agent-service.mjs"
  },
  "build": {
    "appId": "com.forma.design",
    "productName": "Forma",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "out-electron/library-service.mjs",
      "out-electron/agent-service.mjs",
      "!node_modules/**/*"
    ],
    "asar": true,
    "afterSign": "electron/after-sign.mjs",
    "fileAssociations": [
      {
        "ext": "forma",
        "name": "Forma Design Document",
        "role": "Editor"
      },
      {
        "ext": "forma.json",
        "name": "Forma JSON Design Document",
        "role": "Editor"
      },
      {
        "ext": "sketch",
        "name": "Sketch Design Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "fig",
        "name": "Figma Design Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Forma ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "fflate": "^0.8.3",
    "fzstd": "0.1.1",
    "harfbuzzjs": "1.6.4",
    "lucide-react": "^0.468.0",
    "paper": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svgpath": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/emscripten": "1.41.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
